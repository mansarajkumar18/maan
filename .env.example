# MSR Digital Media NOVA AI - Backend Environment Configuration

# Server Port
PORT=3001

# Active Search Provider
# Options: 'duckduckgo' (Free, live real web search), 'tavily' (AI Search Engine), 'serper' (Google Organic)
SEARCH_PROVIDER=duckduckgo

# Tavily AI Search API Key (https://app.tavily.com)
TAVILY_API_KEY=

# Serper Google Search API Key (https://serper.dev)
SERPER_API_KEY=

# Active AI Model Provider
# Options: 'auto' (default: uses configured key or built-in Nova Neural), 'gemini', 'openai', 'groq', 'nova-neural'
AI_PROVIDER=auto

# Optional: Specific AI Model Name (e.g. 'gemini-1.5-flash', 'gpt-4o-mini', 'llama-3.3-70b-versatile')
AI_MODEL=

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=
